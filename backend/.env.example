DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Deployment only:
# DJANGO_ALLOWED_HOSTS=example.com
# DJANGO_SECURE_COOKIES=1   # only behind HTTPS; on plain http it breaks login
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/1  # required when DJANGO_DEBUG=0
# RATE_LIMIT_PREFIX=rebook:rate:v1            # identical on every application worker
# RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1/32     # only actual reverse proxy peers
# RATE_LIMIT_PROXY_COUNT=1                   # default 0 ignores forwarded headers
